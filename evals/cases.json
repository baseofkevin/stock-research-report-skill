{
  "_note": "回归用例清单：cases/*.json 是输入，expect 是断言。改脚本后跑 `python3 evals/run.py`，全绿再提交。断言键：expect_valid / expect_error_contains / expect_warn_contains / must_contain（md+html）/ html_contains / html_not_contains / md_not_contains / expect_stance / allow_only_warns。",
  "cases": [
    {
      "file": "cases/mingyue-v2.json",
      "desc": "v2 完整样例（明月镜片实跑数据）",
      "expect_valid": true,
      "expect_stance": "看好，但等安全边际",
      "must_contain": [
        "排雷扫描（命中 0 / 25 条）",
        "25 条逐条过，无一命中",
        "① 单季主表",
        "初步判断："
      ]
    },
    {
      "file": "cases/minimal-v1.json",
      "desc": "v1 旧结构，验证向后兼容（应告警但仍能出报告）",
      "expect_valid": true,
      "allow_only_warns": true,
      "must_contain": [
        "跨年趋势",
        "资产负债"
      ]
    },
    {
      "file": "cases/broken-v2.json",
      "desc": "四类故意错误，validation 必须失败",
      "expect_valid": false,
      "expect_error_contains": [
        "有 10 个值",
        "含非数字",
        "id=99",
        "标注 +58"
      ]
    },
    {
      "file": "cases/partial-nulls.json",
      "desc": "3 项不可评：分母剔除 + 归一化得分率",
      "expect_valid": true,
      "must_contain": [
        "不可评",
        "可评 13 / 16 项",
        "七、企业估值"
      ]
    },
    {
      "file": "cases/valuation-v2.json",
      "desc": "v2 + 企业估值块（PE/PB/PS 历史分位），验证分位与 series 自洽、三个指标都有图",
      "expect_valid": true,
      "must_contain": [
        "七、企业估值",
        "历史分位",
        "中位",
        "② 跨年趋势图"
      ]
    },
    {
      "file": "cases/missing-sections-v2.json",
      "desc": "缺 5 节 + redflags_checked：结构闸门必须报错",
      "expect_valid": false,
      "expect_error_contains": [
        "缺少必需区块",
        "redflags_checked"
      ]
    },
    {
      "file": "cases/price-string-v2.json",
      "desc": "price 图值是字符串：validate 必须报错，渲染器不能崩",
      "expect_valid": false,
      "expect_error_contains": [
        "price.chart_data",
        "不是数字"
      ]
    },
    {
      "file": "cases/zero-hit-no-note-v2.json",
      "desc": "零命中但 redflags_note 为空 + 同日末端点与 `current` 数值不一致：两道新闸门都要报错",
      "expect_valid": false,
      "expect_error_contains": [
        "redflags_note",
        "同一时点"
      ]
    },
    {
      "file": "cases/stale-endpoint-v2.json",
      "desc": "估值末端点早于报告日（月末采样正常）：只提醒，不逼人往序列里塞假点",
      "expect_valid": true,
      "expect_warn_contains": [
        "末点比报告日"
      ]
    },
    {
      "file": "cases/rich-text-v2.json",
      "desc": "富文本：**粗体** 与 `行内代码` 必须变成标签，HTML 里不许留字面量（N1/#3）",
      "expect_valid": true,
      "html_contains": [
        "<strong>26Q1 55.20% → 26Q3 60.08%</strong>",
        "<code>GrossIncomeRatio</code>",
        "<strong>每季报必查</strong>"
      ],
      "html_not_contains": [
        "**"
      ],
      "must_contain": [
        "七、企业估值"
      ]
    },
    {
      "file": "cases/watchlist-dict-v2.json",
      "desc": "watchlist 写成 dict：validate 必须报错，产物不许出现 Python 字面量（#2）",
      "expect_valid": false,
      "expect_error_contains": [
        "必须是字符串"
      ],
      "html_not_contains": [
        "{'指标'",
        "{'阈值'"
      ]
    },
    {
      "file": "cases/outliers-v2.json",
      "desc": "估值样本含 302 倍 PE 却没给缩尾口径：必须告警（#4）",
      "expect_valid": true,
      "expect_warn_contains": [
        "缩尾"
      ],
      "html_not_contains": [
        "缩尾后"
      ]
    },
    {
      "file": "cases/outliers-trimmed-v2.json",
      "desc": "给了 percentile_trimmed：徽章并排两个口径，极端点画空心圈（#4）",
      "expect_valid": true,
      "html_contains": [
        "历史 42% 分位（缩尾后 56%）",
        "stroke=\"#c0392b\""
      ]
    }
  ]
}
